# Copy this file to .env.local and fill in your values.

# Anthropic API key (server-side only; never sent to the browser).
ANTHROPIC_API_KEY=

# Claude model used for vocabulary and question generation.
ANTHROPIC_MODEL=claude-sonnet-5-5

# SQLite database location (relative to this folder).
DATABASE_URL=file:./dev.db

# Optional: set to "true" to use built-in sample data instead of calling Claude.
# Handy for offline demos and testing without an API key.
SPEAKEASY_MOCK_AI=false

# Optional: hide the "Try the demo account" button on the login page.
# SPEAKEASY_SHOW_DEMO=false
